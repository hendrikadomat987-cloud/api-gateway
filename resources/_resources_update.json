    {
      "parameters": {
        "jsCode": "const tenant_id = ($json.tenant_id || '').trim();\nconst id = ($json.id || '').trim();\nconst name = $json.name ? ($json.name + '').trim() : null;\nconst type = $json.type ? ($json.type + '').trim().toLowerCase() : null;\nconst content = $json.content ? ($json.content + '').trim() : null;\nconst status = $json.status ? ($json.status + '').trim().toLowerCase() : null;\n\nconst errors = [];\nlet errorCode = 'VALIDATION_ERROR';\nconst UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nconst VALID_TYPES = ['document','template','script','faq'];\nconst VALID_STATUSES = ['active','draft','archived'];\n\nif (!tenant_id) errors.push('tenant_id is required');\nelse if (!UUID_RE.test(tenant_id)) errors.push('tenant_id must be a valid UUID');\n\nif (!id) {\n  errors.push('id is required');\n  errorCode = 'MISSING_ID';\n} else if (!UUID_RE.test(id)) {\n  errors.push('id must be a valid UUID');\n  errorCode = 'INVALID_ID';\n}\n\nif (name === null && type === null && content === null && status === null) {\n  errors.push('at least one of name, type, content, or status is required');\n}\n\nif (name !== null && name === '') {\n  errors.push('name must not be empty');\n}\n\nif (type !== null && !VALID_TYPES.includes(type)) {\n  errors.push('type must be one of: document, template, script, faq');\n}\n\nif (status !== null && !VALID_STATUSES.includes(status)) {\n  errors.push('status must be one of: active, draft, archived');\n}\n\nreturn [{\n  json: {\n    valid: errors.length === 0,\n    errorCode: errors.length > 0 ? errorCode : null,\n    errors,\n    tenant_id,\n    id,\n    name,\n    type,\n    content,\n    status\n  }\n}];"
