        "jsCode": "const raw = ($json.error && ($json.error.message || String($json.error))) || 'Database error';\nconst lower = raw.toLowerCase();\nlet code = 'DB_ERROR'; let message = raw;\nif (lower.includes('invalid_type') || lower.includes('invalid type')) {\n  code = 'VALIDATION_ERROR'; message = 'type must be one of: document, template, script, faq';\n} else if (lower.includes('invalid_status') || lower.includes('invalid status')) {\n  code = 'VALIDATION_ERROR'; message = 'status must be one of: active, draft, archived';\n}\nreturn [{ json: { code, message } }];"
